--- !u!114 &1619869064
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1619869062}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fa3edabb3c788e2438d38ab83e37d4f8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueConversationData
  conversationId: ENTER_HOUSE
  allowSkip: 1
  skipButtonText: "B\u1ECF qua h\u01B0\u1EDBng d\u1EABn"
  defaultSecondsPerCharacter: 0.00075
  returnCameraToPlayerOnEnd: 1
  returnCameraMoveTime: 0.3
  lines:
  - speaker: {fileID: 11400000, guid: ab24398083758814e99f21fc8af11dae, type: 2}
    content: "Alo alo 1 2 3 4 alo alo Mic check alo alo... Nghe r\xF5 tr\u1EA3 l\u1EDDi"
    cameraMode: 4
    customCameraTarget: {fileID: 0}
    cameraMoveTime: 0.75
    waitForCameraBeforeTyping: 1
    secondsPerCharacterOverride: -1
    waitAfterTypingBeforeContinue: 0
    setActiveTrueOnEnter: []
    setActiveFalseOnEnter: []
  - speaker: {fileID: 11400000, guid: 0a1f16f04e824c84196c75d662c6a618, type: 2}
    content: "R\u1EA5t r\xF5. B\xEAn \u0111\xF3 th\u1EBF n\xE0o r\u1ED3i?"
    cameraMode: 3
    customCameraTarget: {fileID: 0}
    cameraMoveTime: 0.25
    waitForCameraBeforeTyping: 1
    secondsPerCharacterOverride: -1
    waitAfterTypingBeforeContinue: 0
    setActiveTrueOnEnter: []
    setActiveFalseOnEnter: []
  - speaker: {fileID: 11400000, guid: ab24398083758814e99f21fc8af11dae, type: 2}
    content: "Th\u1EDDi ti\u1EBFt \u1EA5m \xE1p. C\xF2n b\xEAn c\u1EADu th\xEC sao? "
    cameraMode: 3
    customCameraTarget: {fileID: 0}
    cameraMoveTime: 0.75
    waitForCameraBeforeTyping: 1
    secondsPerCharacterOverride: -1
    waitAfterTypingBeforeContinue: 0
    setActiveTrueOnEnter: []
    setActiveFalseOnEnter: []
  - speaker: {fileID: 11400000, guid: 0a1f16f04e824c84196c75d662c6a618, type: 2}
    content: "H\u01A1i se l\u1EA1nh, bao quanh b\u1EDFi m\u1ED9t \u0111\u1ED1ng \u0111\u1EB7c
      nhi\u1EC7m tinh nhu\u1EC7"
    cameraMode: 3
    customCameraTarget: {fileID: 0}
    cameraMoveTime: 0.75
    waitForCameraBeforeTyping: 1
    secondsPerCharacterOverride: -1
    waitAfterTypingBeforeContinue: 0
    setActiveTrueOnEnter: []
    setActiveFalseOnEnter: []
  - speaker: {fileID: 11400000, guid: ab24398083758814e99f21fc8af11dae, type: 2}
    content: "Th\u1EBF th\xEC qu\xE1 tuy\u1EC7t cho m\u1ED9t bu\u1ED5i \u0111\u1ED9t
      nh\u1EADp r\u1ED3i"
    cameraMode: 3
    customCameraTarget: {fileID: 0}
    cameraMoveTime: 0.75
    waitForCameraBeforeTyping: 1
    secondsPerCharacterOverride: -1
    waitAfterTypingBeforeContinue: 0
    setActiveTrueOnEnter: []
    setActiveFalseOnEnter: []
  - speaker: {fileID: 11400000, guid: ab24398083758814e99f21fc8af11dae, type: 2}
    content: "GiGa Corp \u0111ang \xE2m m\u01B0u \u0111i\u1EC1u g\xEC \u0111\xF3,
      n\xEAn nhi\u1EC7m v\u1EE5 l\u1EA7n n\xE0y c\u1EE7a b\u1EA1n l\xE0 \u0111\u1ED9t
      nh\u1EADp v\xE0o, \u0111i\u1EC1u tra xem \xE2m m\u01B0u c\u1EE7a b\u1ECDn ch\xFAng
      l\xE0 g\xEC tr\u01B0\u1EDBc khi qu\xE1 mu\u1ED9n"
    cameraMode: 3
    customCameraTarget: {fileID: 0}
    cameraMoveTime: 0.75
    waitForCameraBeforeTyping: 1
    secondsPerCharacterOverride: -1
    waitAfterTypingBeforeContinue: 0
    setActiveTrueOnEnter: []
    setActiveFalseOnEnter: []
  - speaker: {fileID: 11400000, guid: ab24398083758814e99f21fc8af11dae, type: 2}
    content: "Gi\u1EEF y\xEAn l\u1EB7ng h\u1EBFt m\u1EE9c. S\u1EBD r\u1EA5t tuy\u1EC7t
      n\u1EBFu nh\u01B0 l\u0169 GiGa Corp kh\xF4ng bi\u1EBFt b\u1EA1n \u0111\xE3
      \u1EDF \u0111\xF3."
    cameraMode: 3
    customCameraTarget: {fileID: 0}
    cameraMoveTime: 0.75
    waitForCameraBeforeTyping: 1
    secondsPerCharacterOverride: -1
    waitAfterTypingBeforeContinue: 0
    setActiveTrueOnEnter: []
    setActiveFalseOnEnter: []
  - speaker: {fileID: 11400000, guid: ab24398083758814e99f21fc8af11dae, type: 2}
    content: "Theo d\xF5i t\xEAn b\u1EA3o v\u1EC7 kia, h\u1EAFn ta s\u1EBD d\u1EABn
      b\u1EA1n v\xE0o s\xE2u b\xEAn trong. Ch\u1EC9 c\u1EA7n \u0111\u1EEBng \u0111\u1EBFn
      qu\xE1 g\u1EA7n l\xE0 \u0111\u01B0\u1EE3c."
    cameraMode: 2
    customCameraTarget: {fileID: 118094167}
    cameraMoveTime: 0.5
    waitForCameraBeforeTyping: 1
    secondsPerCharacterOverride: -1
    waitAfterTypingBeforeContinue: 0
    setActiveTrueOnEnter:
    - {fileID: 118094166}
    setActiveFalseOnEnter: []
